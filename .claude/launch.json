{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8001"],
      "env": { "NEUROVISION_CORS_ORIGINS": "http://localhost:5174,http://127.0.0.1:5174" },
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174"],
      "env": { "VITE_API_BASE_URL": "http://localhost:8001" },
      "port": 5174,
      "autoPort": false
    }
  ]
}
