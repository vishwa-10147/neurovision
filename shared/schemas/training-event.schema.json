{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurovision.local/schemas/training-event.schema.json",
  "$defs": {
    "ActivationHealth": {
      "additionalProperties": false,
      "description": "One activation module's output on the script's fixed probe batch.",
      "properties": {
        "kind": {
          "enum": [
            "relu",
            "tanh",
            "sigmoid",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "title": "Std",
          "type": "number"
        },
        "dead_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dead Fraction"
        },
        "saturated_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saturated Fraction"
        }
      },
      "required": [
        "kind",
        "mean",
        "std"
      ],
      "title": "ActivationHealth",
      "type": "object"
    },
    "GpuStats": {
      "additionalProperties": false,
      "description": "One GPU as seen by the training script (NVML or torch.cuda).",
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "util_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Util Percent"
        },
        "mem_used_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mem Used Bytes"
        },
        "mem_total_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mem Total Bytes"
        },
        "temperature_c": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature C"
        },
        "power_w": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power W"
        }
      },
      "required": [
        "index"
      ],
      "title": "GpuStats",
      "type": "object"
    },
    "ParameterHealth": {
      "additionalProperties": false,
      "description": "One module that owns parameters, measured right after an optimizer step.",
      "properties": {
        "grad_norm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grad Norm"
        },
        "weight_norm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Norm"
        },
        "update_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Update Ratio"
        },
        "parameters": {
          "default": 0,
          "minimum": 0,
          "title": "Parameters",
          "type": "integer"
        }
      },
      "title": "ParameterHealth",
      "type": "object"
    },
    "RunAlert": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "minimum": 1,
          "title": "Alert Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "non_finite_loss",
            "non_finite_gradients",
            "exploding_gradients",
            "vanishing_gradients",
            "update_ratio_high",
            "update_ratio_low",
            "dead_units",
            "saturated_units",
            "loss_spike",
            "loss_plateau",
            "overfitting",
            "gpu_underused",
            "gpu_memory_high",
            "alerts_suppressed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "layer": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer"
        },
        "message": {
          "maxLength": 300,
          "title": "Message",
          "type": "string"
        },
        "advice": {
          "maxLength": 300,
          "title": "Advice",
          "type": "string"
        }
      },
      "required": [
        "alert_id",
        "kind",
        "severity",
        "step",
        "message",
        "advice"
      ],
      "title": "RunAlert",
      "type": "object"
    },
    "RunAlertEvent": {
      "additionalProperties": false,
      "description": "The server's health rules flagged a problem in an external run.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "event_type": {
          "const": "run.alert",
          "title": "Event Type",
          "type": "string"
        },
        "alert": {
          "$ref": "#/$defs/RunAlert"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "event_type",
        "alert"
      ],
      "title": "RunAlertEvent",
      "type": "object"
    },
    "RunCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "minimum": 1,
          "title": "Command Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "pause",
            "resume",
            "stop",
            "checkpoint",
            "set_lr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "status": {
          "enum": [
            "pending",
            "applied",
            "rejected",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        }
      },
      "required": [
        "command_id",
        "kind",
        "status",
        "created_at"
      ],
      "title": "RunCommand",
      "type": "object"
    },
    "RunCommandEvent": {
      "additionalProperties": false,
      "description": "A command was issued to an external run, or its status changed.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "event_type": {
          "const": "run.command",
          "title": "Event Type",
          "type": "string"
        },
        "command": {
          "$ref": "#/$defs/RunCommand"
        },
        "paused": {
          "title": "Paused",
          "type": "boolean"
        },
        "learning_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learning Rate"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "event_type",
        "command",
        "paused"
      ],
      "title": "RunCommandEvent",
      "type": "object"
    },
    "StepHealth": {
      "additionalProperties": false,
      "description": "Training-health statistics measured by the script for one step.",
      "properties": {
        "grad_norm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grad Norm"
        },
        "learning_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learning Rate"
        },
        "nonfinite_grads": {
          "default": 0,
          "minimum": 0,
          "title": "Nonfinite Grads",
          "type": "integer"
        },
        "nonfinite_metrics": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Nonfinite Metrics",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ParameterHealth"
          },
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Parameters",
          "type": "object"
        },
        "activations": {
          "additionalProperties": {
            "$ref": "#/$defs/ActivationHealth"
          },
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Activations",
          "type": "object"
        }
      },
      "title": "StepHealth",
      "type": "object"
    },
    "StepSystem": {
      "additionalProperties": false,
      "description": "Resource use and timing measured by the script for one step.",
      "properties": {
        "elapsed_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed S"
        },
        "step_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Time S"
        },
        "eta_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eta S"
        },
        "samples_per_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Samples Per S"
        },
        "cpu_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Percent"
        },
        "process_cpu_percent": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Cpu Percent"
        },
        "ram_used_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ram Used Bytes"
        },
        "ram_total_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ram Total Bytes"
        },
        "process_rss_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Rss Bytes"
        },
        "cuda_allocated_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Allocated Bytes"
        },
        "cuda_reserved_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Reserved Bytes"
        },
        "device": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "gpus": {
          "items": {
            "$ref": "#/$defs/GpuStats"
          },
          "maxItems": 8,
          "title": "Gpus",
          "type": "array"
        }
      },
      "title": "StepSystem",
      "type": "object"
    },
    "TrainingCancelled": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "event_type": {
          "const": "training.cancelled",
          "title": "Event Type",
          "type": "string"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "event_type",
        "step"
      ],
      "title": "TrainingCancelled",
      "type": "object"
    },
    "TrainingCompleted": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "event_type": {
          "const": "training.completed",
          "title": "Event Type",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 16,
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "event_type",
        "epoch",
        "step",
        "metrics"
      ],
      "title": "TrainingCompleted",
      "type": "object"
    },
    "TrainingFailed": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "event_type": {
          "const": "training.failed",
          "title": "Event Type",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "event_type",
        "message"
      ],
      "title": "TrainingFailed",
      "type": "object"
    },
    "TrainingStarted": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "event_type": {
          "const": "training.started",
          "title": "Event Type",
          "type": "string"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "total_epochs": {
          "minimum": 1,
          "title": "Total Epochs",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "event_type",
        "model_id",
        "total_epochs"
      ],
      "title": "TrainingStarted",
      "type": "object"
    },
    "TrainingStep": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "event_type": {
          "const": "training.step",
          "title": "Event Type",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 16,
          "title": "Metrics",
          "type": "object"
        },
        "selected_activations": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "maxItems": 256,
            "type": "array"
          },
          "maxProperties": 8,
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Selected Activations",
          "type": "object"
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepHealth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "system": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepSystem"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "event_type",
        "epoch",
        "step",
        "metrics"
      ],
      "title": "TrainingStep",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "run.alert": "#/$defs/RunAlertEvent",
      "run.command": "#/$defs/RunCommandEvent",
      "training.cancelled": "#/$defs/TrainingCancelled",
      "training.completed": "#/$defs/TrainingCompleted",
      "training.failed": "#/$defs/TrainingFailed",
      "training.started": "#/$defs/TrainingStarted",
      "training.step": "#/$defs/TrainingStep"
    },
    "propertyName": "event_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TrainingStarted"
    },
    {
      "$ref": "#/$defs/TrainingStep"
    },
    {
      "$ref": "#/$defs/TrainingCompleted"
    },
    {
      "$ref": "#/$defs/TrainingCancelled"
    },
    {
      "$ref": "#/$defs/TrainingFailed"
    },
    {
      "$ref": "#/$defs/RunCommandEvent"
    },
    {
      "$ref": "#/$defs/RunAlertEvent"
    }
  ],
  "title": "TrainingEvent"
}
