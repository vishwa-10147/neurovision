{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurovision.local/schemas/external-run.schema.json",
  "$defs": {
    "ActivationHealth": {
      "additionalProperties": false,
      "description": "One activation module's output on the script's fixed probe batch.",
      "properties": {
        "kind": {
          "enum": [
            "relu",
            "tanh",
            "sigmoid",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "title": "Std",
          "type": "number"
        },
        "dead_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dead Fraction"
        },
        "saturated_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saturated Fraction"
        }
      },
      "required": [
        "kind",
        "mean",
        "std"
      ],
      "title": "ActivationHealth",
      "type": "object"
    },
    "CommandAck": {
      "additionalProperties": false,
      "description": "The script's answer to one command.",
      "properties": {
        "status": {
          "enum": [
            "applied",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "paused": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paused"
        },
        "learning_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learning Rate"
        }
      },
      "required": [
        "status"
      ],
      "title": "CommandAck",
      "type": "object"
    },
    "CommandList": {
      "properties": {
        "commands": {
          "items": {
            "$ref": "#/$defs/RunCommand"
          },
          "title": "Commands",
          "type": "array"
        }
      },
      "required": [
        "commands"
      ],
      "title": "CommandList",
      "type": "object"
    },
    "CommandRequest": {
      "additionalProperties": false,
      "description": "Issued from the dashboard; the script applies it at its next run.poll().",
      "properties": {
        "kind": {
          "enum": [
            "pause",
            "resume",
            "stop",
            "checkpoint",
            "set_lr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CommandRequest",
      "type": "object"
    },
    "EventBatch": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/LoggedStep"
          },
          "maxItems": 32,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "title": "EventBatch",
      "type": "object"
    },
    "IngestResult": {
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "integer"
        },
        "steps_logged": {
          "title": "Steps Logged",
          "type": "integer"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/RunCommand"
          },
          "title": "Commands",
          "type": "array"
        }
      },
      "required": [
        "accepted",
        "steps_logged"
      ],
      "title": "IngestResult",
      "type": "object"
    },
    "LoggedStep": {
      "additionalProperties": false,
      "description": "One training.step without the fields the server stamps itself.",
      "properties": {
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 16,
          "title": "Metrics",
          "type": "object"
        },
        "selected_activations": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "maxItems": 256,
            "type": "array"
          },
          "maxProperties": 8,
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Selected Activations",
          "type": "object"
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepHealth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "epoch",
        "step",
        "metrics"
      ],
      "title": "LoggedStep",
      "type": "object"
    },
    "ParameterHealth": {
      "additionalProperties": false,
      "description": "One module that owns parameters, measured right after an optimizer step.",
      "properties": {
        "grad_norm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grad Norm"
        },
        "weight_norm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Norm"
        },
        "update_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Update Ratio"
        },
        "parameters": {
          "default": 0,
          "minimum": 0,
          "title": "Parameters",
          "type": "integer"
        }
      },
      "title": "ParameterHealth",
      "type": "object"
    },
    "RunCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "minimum": 1,
          "title": "Command Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "pause",
            "resume",
            "stop",
            "checkpoint",
            "set_lr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "status": {
          "enum": [
            "pending",
            "applied",
            "rejected",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        }
      },
      "required": [
        "command_id",
        "kind",
        "status",
        "created_at"
      ],
      "title": "RunCommand",
      "type": "object"
    },
    "RunCreate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "total_epochs": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Total Epochs",
          "type": "integer"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "controls": {
          "items": {
            "enum": [
              "pause",
              "resume",
              "stop",
              "checkpoint",
              "set_lr"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Controls",
          "type": "array"
        }
      },
      "required": [
        "name",
        "total_epochs"
      ],
      "title": "RunCreate",
      "type": "object"
    },
    "RunCreated": {
      "properties": {
        "run": {
          "$ref": "#/$defs/RunInfo"
        },
        "write_token": {
          "title": "Write Token",
          "type": "string"
        }
      },
      "required": [
        "run",
        "write_token"
      ],
      "title": "RunCreated",
      "type": "object"
    },
    "RunFinish": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "status"
      ],
      "title": "RunFinish",
      "type": "object"
    },
    "RunInfo": {
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Id"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "total_epochs": {
          "title": "Total Epochs",
          "type": "integer"
        },
        "epoch": {
          "title": "Epoch",
          "type": "integer"
        },
        "step": {
          "title": "Step",
          "type": "integer"
        },
        "steps_logged": {
          "title": "Steps Logged",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        },
        "last_event_at": {
          "title": "Last Event At",
          "type": "number"
        },
        "controls": {
          "items": {
            "enum": [
              "pause",
              "resume",
              "stop",
              "checkpoint",
              "set_lr"
            ],
            "type": "string"
          },
          "title": "Controls",
          "type": "array"
        },
        "paused": {
          "title": "Paused",
          "type": "boolean"
        },
        "learning_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Learning Rate"
        },
        "pending_commands": {
          "title": "Pending Commands",
          "type": "integer"
        },
        "alerts": {
          "title": "Alerts",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "name",
        "model_id",
        "status",
        "total_epochs",
        "epoch",
        "step",
        "steps_logged",
        "created_at",
        "last_event_at",
        "controls",
        "paused",
        "learning_rate",
        "pending_commands",
        "alerts"
      ],
      "title": "RunInfo",
      "type": "object"
    },
    "RunList": {
      "properties": {
        "runs": {
          "items": {
            "$ref": "#/$defs/RunInfo"
          },
          "title": "Runs",
          "type": "array"
        }
      },
      "required": [
        "runs"
      ],
      "title": "RunList",
      "type": "object"
    },
    "StepHealth": {
      "additionalProperties": false,
      "description": "Training-health statistics measured by the script for one step.",
      "properties": {
        "grad_norm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grad Norm"
        },
        "learning_rate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learning Rate"
        },
        "nonfinite_grads": {
          "default": 0,
          "minimum": 0,
          "title": "Nonfinite Grads",
          "type": "integer"
        },
        "nonfinite_metrics": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Nonfinite Metrics",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ParameterHealth"
          },
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Parameters",
          "type": "object"
        },
        "activations": {
          "additionalProperties": {
            "$ref": "#/$defs/ActivationHealth"
          },
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Activations",
          "type": "object"
        }
      },
      "title": "StepHealth",
      "type": "object"
    }
  },
  "title": "ExternalRun"
}
